<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="960.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.lidyvariedadesdesktop.HelloController">
    <!-- Topo: Cabecalho e Barra de Ferramentas -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" styleClass="header-box">
                <VBox spacing="2.0">
                    <Label styleClass="header-title" text="Lidy Variedades" />
                    <Label styleClass="header-subtitle" text="Sistema de Gestão &amp; Controle de Estoque" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblConexao" style="-fx-text-fill: #4ade80; -fx-font-weight: bold; -fx-font-size: 12px;" text="● Conectado à API" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar-box">
                <TextField fx:id="txtPesquisa" prefWidth="300.0" promptText="Pesquisar produto pelo nome..." styleClass="search-field" />
                <Button onAction="#onPesquisar" styleClass="btn-secondary" text="🔍 Buscar" />
                <Button onAction="#onLimparPesquisa" styleClass="btn-secondary" text="Limpar" />

                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#onCarregarProdutos" styleClass="btn-secondary" text="🔄 Atualizar" />
                <Button onAction="#onNovoProduto" styleClass="btn-primary" text="+ Novo Produto" />
                <Button onAction="#onExcluirProduto" styleClass="btn-danger" text="🗑 Excluir" />
            </HBox>
        </VBox>
    </top>

    <!-- Centro: Tabela de Produtos -->
    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
            </padding>
            <TableView fx:id="tabelaProdutos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                    <TableColumn fx:id="colCodigo" prefWidth="120.0" text="Cód. Referência" />
                    <TableColumn fx:id="colNome" prefWidth="250.0" text="Nome do Produto" />
                    <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoria" />
                    <TableColumn fx:id="colMarca" prefWidth="120.0" text="Marca" />
                    <TableColumn fx:id="colPrecoCusto" prefWidth="100.0" text="Preço Custo (R$)" />
                    <TableColumn fx:id="colPrecoVenda" prefWidth="110.0" text="Preço Venda (R$)" />
                    <TableColumn fx:id="colEstoque" prefWidth="80.0" text="Estoque" />
                    <TableColumn fx:id="colEstoqueMinimo" prefWidth="90.0" text="Est. Mínimo" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- Rodape: Barra de Status -->
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="footer-box">
            <Label fx:id="lblStatus" styleClass="status-label" text="Carregando produtos..." />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="status-label" text="Backend: http://localhost:8080" />
        </HBox>
    </bottom>
</BorderPane>
